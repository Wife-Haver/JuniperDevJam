;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="SpinToWin"
run/main_scene="uid://do7l3vsqxf4lj"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

PlayerManager="*uid://lnlkdkjvm74h"
ScreenManager="*uid://cjveh588tykkt"
ScoreManager="*uid://l7dn7yjbbtwv"

[display]

window/size/viewport_width=640
window/size/viewport_height=640
window/size/window_width_override=864
window/size/window_height_override=864
window/stretch/mode="canvas_items"
window/canvas_textures/default_texture_filter=0

[global_group]

Player=""

